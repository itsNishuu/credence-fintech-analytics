model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataSource","LoadCsv","Calendar", "Branch", "Grade", "Borrower", "Loan", "Loan Month", "Financials"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Calendar
ref table Branch
ref table Grade
ref table Borrower
ref table Loan
ref table 'Loan Month'
ref table Financials
